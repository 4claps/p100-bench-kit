#!/usr/bin/env python3
"""Fake llama-server: /health, /v1/chat/completions with timings, print_timing log lines."""
import json, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
a = sys.argv
port = int(a[a.index("--port") + 1])
mtp = "--spec-type" in a
class H(BaseHTTPRequestHandler):
    def log_message(self, *x): pass
    def _send(self, obj, code=200):
        b = json.dumps(obj).encode(); self.send_response(code)
        self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(b)))
        self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        self._send({"status": "ok"})
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        msg = body["messages"][-1]["content"]
        n = body.get("max_tokens", 16)
        t = {"prompt_n": len(msg) // 4, "prompt_per_second": 380.0, "predicted_n": n, "predicted_per_second": 50.0 if mtp else 26.0}
        if mtp:
            t |= {"draft_n": 300, "draft_n_accepted": 200}
        print(f"I slot print_timing: id  0 | task 0 | prompt eval time =    100.00 ms /   {t['prompt_n']} tokens (    0.30 ms per token,   380.00 tokens per second)", flush=True)
        print(f"I slot print_timing: id  0 | task 0 |        eval time =   1000.00 ms /   {n} tokens (   20.00 ms per token,    {t['predicted_per_second']:.2f} tokens per second)", flush=True)
        if "RESULT=" in msg:
            content = "RESULT=323"
        else:
            content = "ok"
        self._send({"choices": [{"message": {"role": "assistant", "content": content}}], "timings": t})
print("fake llama-server listening", flush=True)
HTTPServer(("127.0.0.1", port), H).serve_forever()
